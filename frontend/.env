# Frontend settings, read by Vite at build and dev-server start.
# Every VITE_ value is compiled into the JavaScript the browser downloads, so
# nothing secret belongs here. Put machine-specific overrides in .env.local,
# which git ignores.

# The API's base URL. Required; its port must match PORT in api/.env.
VITE_API_URL=http://localhost:3000/api
