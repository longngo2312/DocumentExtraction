# Copy to api/.env and fill in JWT_SECRET. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Every key below is required: the API names any missing one and will not start.

# --- Server ---------------------------------------------------------------
PORT=3000
# The frontend's address exactly as the browser shows it. Login cookies only
# work for this origin; a mismatch shows up as CORS errors in the browser.
CORS_ORIGIN=http://localhost:5173
# "production" makes the refresh cookie Secure (HTTPS only). The only optional key.
NODE_ENV=development

# --- Auth -----------------------------------------------------------------
# Signs access tokens. Changing it signs everyone out of their current access
# token; refresh tokens are unaffected and re-issue one.
JWT_SECRET=

# --- Ollama ---------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
# Chat/extraction model; must be pulled (`ollama pull <name>`) and fit in VRAM.
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# --- Qdrant ---------------------------------------------------------------
QDRANT_URL=http://localhost:6333
